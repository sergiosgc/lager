def bail(exit_code=1):
    sys.exit(exit_code)

def static_vars(**kwargs):
    def decorate(func):
        for k in kwargs:
            setattr(func, k, kwargs[k])
        return func
    return decorate

@static_vars(result_memoization=None)
def db_connection(databaseFile=None):
    if databaseFile is None:
        databaseFile = os.path.dirname(os.path.realpath(__file__)) + "/../database.sqlite"
    if db_connection.result_memoization is None:
        db_connection.result_memoization = sqlite3.connect(databaseFile)
        db_upgrade()
    return db_connection.result_memoization

def db_upgrade():
    if 0 == len(db_query("SELECT name FROM sqlite_master WHERE type='table' AND name='db_version'")):
        db_create()
    (version,) = db_query("SELECT version FROM db_version LIMIT 1")[0]
    # Upgrade between versions here (not needed, as there is only one db version as of right now)
    if version != 1:
        raise Exception("Version database is more advanced than current inventory script module version")

def db_create():
    for line in '''
CREATE TABLE host_group(id INTEGER PRIMARY KEY, parent INTEGER REFERENCES host_groups(id), name TEXT);
CREATE TABLE host(id INTEGER PRIMARY KEY, name TEXT);
CREATE TABLE variable(id INTEGER PRIMARY KEY, name TEXT);
CREATE TABLE service(id INTEGER PRIMARY KEY, name TEXT, parent references service(id));
CREATE TABLE host_variable(variable INTEGER NOT NULL REFERENCES variable(id), host INTEGER NOT NULL REFERENCES host(id), value TEXT NOT NULL, PRIMARY KEY (variable, host));
CREATE TABLE service_variable(variable INTEGER NOT NULL REFERENCES variable(id), "service" INTEGER NOT NULL REFERENCES "service"(id), value TEXT NOT NULL, PRIMARY KEY (variable, "service"));
CREATE TABLE service_instance(id INTEGER PRIMARY KEY, "service" INTEGER NOT NULL REFERENCES "service"(id), host INTEGER NOT NULL REFERENCES host(id), ip TEXT NOT NULL, name TEXT NOT NULL, unique (service, host, ip), unique(service, host, name));
CREATE TABLE service_instance_variable(variable INTEGER NOT NULL REFERENCES variable(id), instance INTEGER NOT NULL REFERENCES service_instance(id), value TEXT NOT NULL, primary key (variable, instance));
CREATE TABLE host_group_variable(variable INTEGER NOT NULL REFERENCES variable(id), "group" INTEGER NOT NULL REFERENCES "group"(id), value TEXT NOT NULL, PRIMARY KEY (variable, "group"));
CREATE TABLE host_group_membership(host integer references host(id), "group" integer references host_group(id), primary key (host, "group"));
CREATE TABLE db_version(key text primary key check (key = 'single-row'), version integer);
INSERT INTO db_version VALUES('single-row', 1);
    '''.split("\n"):
        if ';' in line: db_query(line)
    db_connection().commit()

def db_query(query, *args):
    conn = db_connection()
    c = conn.cursor()
    c.execute(query, args)
    result = c.fetchall()
    c.close()
    return result

def db_data_manipulation(query, *args):
    conn = db_connection()
    c = conn.cursor()
    c.execute(query, args)
    conn.commit()
    c.close()

class Inventory:
    @staticmethod
    def _do_list():
        result = {"_meta": { "hostvars": {} }}
        for depth,group in Host_Group._list():
            result[group] = { 'hosts': [], 'vars': {}, 'children': [] }
            for var_name, ip in db_query(
'''
WITH RECURSIVE
  hierarchical_group(id, parent) AS (
     SELECT id, parent FROM host_group WHERE name = ? AND parent is NULL
     UNION ALL 
     SELECT host_group.id, host_group.parent FROM host_group JOIN hierarchical_group ON hierarchical_group.id = host_group.parent
  )
  SELECT service.name || '_' || service_instance.name, service_instance.ip FROM service JOIN service_instance ON service.id = service_instance.service JOIN (SELECT DISTINCT host.id FROM host JOIN host_group_membership ON host_group_membership.host = host.id JOIN hierarchical_group ON host_group_membership."group" = hierarchical_group.id) AS host ON service_instance.host = host.id
''' , group):
                if 'upstream' not in result[group]['vars']: result[group]['vars']['upstream'] = {}
                if var_name not in result[group]['vars']['upstream']: result[group]['vars']['upstream'][var_name] = []
                result[group]['vars']['upstream'][var_name].append(ip)

        for parent,child in db_query('SELECT p.name, c.name FROM host_group AS p JOiN host_group AS c ON p.id = c.parent ORDER BY p.name'):
            result[parent]['children'].append(child)

        for group,host in db_query('SELECT host_group.name, host.name FROM host_group JOiN host_group_membership ON host_group_membership."group" = host_group.id JOIN host ON host_group_membership.host = host.id ORDER BY host_group.name, host.name'):
            result[group]['hosts'].append(host)

        for group, variable, value in db_query('SELECT host_group.name, variable.name, host_group_variable.value FROM host_group_variable JOIN host_group ON (host_group.id = host_group_variable."group") JOIN variable ON (host_group_variable.variable = variable.id) ORDER BY host_group.name'):
            try:
                result[group]['vars'][variable] = json.loads(value)
            except ValueError:
                sys.stderr.write("Error reading group variable %s with JSON value %s\n" % (variable, value))




        for host, in db_query('SELECT host.name FROM host ORDER BY host.name'):
            result['_meta']['hostvars'][host] = {}
            result['_meta']['hostvars'][host]['service_instances'] = Inventory._service_instances(host)
            result['_meta']['hostvars'][host]['iscsi_disks'] = []
            result['_meta']['hostvars'][host]['nfs_disks'] = []
            result['_meta']['hostvars'][host]['service_ips'] = {}
            for service_name,service_instances_service in result['_meta']['hostvars'][host]['service_instances'].items():
                for local_service_name,service_instances_localservice in service_instances_service.items():
                    result['_meta']['hostvars'][host]['service_ips'][service_instances_localservice['ip']] = True
                    if 'iscsi_disks' in service_instances_localservice['vars']:
                        result['_meta']['hostvars'][host]['iscsi_disks'].extend(service_instances_localservice['vars']['iscsi_disks'])
                    if 'nfs_disks' in service_instances_localservice['vars']:
                        result['_meta']['hostvars'][host]['nfs_disks'].extend(service_instances_localservice['vars']['nfs_disks'])
                    if 'upstream_aliases' in service_instances_localservice['vars']:
                        for local_alias in service_instances_localservice['vars']['upstream_aliases']:
                            full_alias_name = service_name + '_' + local_alias
                            for depth,group in Host_Group._list():
                                if 'upstream' not in result[group]['vars']:
                                    continue
                                if full_alias_name not in result[group]['vars']['upstream']: result[group]['vars']['upstream'][full_alias_name] = []
                                result[group]['vars']['upstream'][full_alias_name].append(service_instances_localservice['ip'])

            result['_meta']['hostvars'][host]['service_ips'] = list(result['_meta']['hostvars'][host]['service_ips'].keys())

        for host,variable,value in db_query('SELECT host.name, variable.name, host_variable.value FROM host join host_variable ON host_variable.host = host.id JOIN variable ON host_variable.variable = variable.id ORDER BY host.name, variable.name'):
            try:
                result['_meta']['hostvars'][host][variable] = json.loads(value)
            except ValueError:
                sys.stderr.write("Error reading host variable %s with JSON value %s\n" % (variable, value))
        return result
    @staticmethod
    def do_list(output_yaml):
        result = Inventory._do_list()
        if output_yaml:
            print(yaml.dump(result))
        else:
            print(json.dumps(result, indent=True))

    @staticmethod
    def _service_instances(host):
        result = {}
        for service, in db_query("SELECT name FROM service"):
            result[service] = {}
        for service,localname,ip in db_query("SELECT service.name, service_instance.name, service_instance.ip FROM service_instance JOIN service ON service_instance.service = service.id JOIN host ON service_instance.host = host.id WHERE host.name = ? ORDER BY host.name, service.name", host):
            result[service][localname] = { 'service': service, 'ip': ip }
            result[service][localname]['hierarchy'] = []
            for name, in db_query(
'''
WITH RECURSIVE
  hierarchical_service(id, name, parent) AS (
     SELECT id, name, parent FROM service WHERE name = ?
     UNION ALL
     SELECT service.id, service.name, service.parent FROM hierarchical_service JOIN service ON service.id = hierarchical_service.parent
  )
  SELECT name FROM hierarchical_service;
'''
            , service):
                result[service][localname]['hierarchy'].append(name)
            result[service][localname]['vars'] = {}
            for (var_name, var_value, var_origin) in Service_Instance._get_vars(host, service, localname):
                try:
                    result[service][localname]['vars'][var_name] = json.loads(var_value)
                except ValueError:
                    sys.stderr.write("Error reading service instance variable %s with JSON value %s\n" % (var_name, var_value))

        return result;

    @staticmethod
    def do_host(host_name, output_yaml, clean_service_instances):
        complete = Inventory._do_list()
        result = complete['_meta']['hostvars'][host_name]
        groups = []
        for group_name,group_data in complete.items():
            if group_name == '_meta': continue
            if 'hosts' not in group_data or 'children' not in group_data: continue
            if host_name in group_data['hosts']: groups.append(group_name)
        while True:
            next_level = []
            for group_name,group_data in complete.items():
                if group_name == '_meta': continue
                if 'hosts' not in group_data or 'children' not in group_data: continue
                if group_name in groups: continue
                if bool([g for g in group_data['children'] if g in groups]): next_level.append(group_name)
            if len(next_level) == 0: break
            groups.extend(next_level)
        
        for group_name in groups:
            for var_name,var_value in complete[group_name]['vars'].items():
                if var_name not in result: result[var_name] = var_value
        
        if clean_service_instances:
            result['service_instances'] = {key: val for key,val in result['service_instances'].items() if len(val) > 0}

        if output_yaml:
            print(yaml.dump(result))
        else:
            print(json.dumps(result, indent=True))

