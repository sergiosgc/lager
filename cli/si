        else:
            db_data_manipulation("UPDATE host_variable SET value = ? WHERE host_variable.variable = (SELECT id FROM variable WHERE name = ?) and host_variable.host = (SELECT id FROM host WHERE host.name = ?)", var_value,var_name, host_name)

    @staticmethod
    def _get_vars(host_name):
        return db_query("""
WITH RECURSIVE
  hierarchical_host_group(id, name, parent, depth) AS (
     SELECT host_group.id, host_group.name, host_group.parent, 0 FROM host_group JOIN host_group_membership ON host_group.id = host_group_membership."group" JOIN host ON host.id = host_group_membership.host WHERE host.name = ?
     UNION ALL
     SELECT host_group.id, host_group.name, host_group.parent, depth+1 FROM hierarchical_host_group JOIN host_group ON hierarchical_host_group.parent = host_group.id
  ),
 flattened(depth, variable, value, sourcename) AS (
   SELECT hierarchical_host_group.depth+1, variable.id, host_group_variable.value, hierarchical_host_group.name
   FROM hierarchical_host_group JOIN host_group_variable ON hierarchical_host_group.id = host_group_variable."group" JOIN variable ON variable.id = host_group_variable.variable
   UNION ALL
   SELECT 0 AS depth, variable.id, host_variable.value, variable.name FROM host JOIN host_variable ON host_variable.host = host.id JOIN variable ON variable.id = host_variable.variable WHERE host.name = ?
 )
SELECT
 variable.name AS name,
 flattened.value AS value,
 flattened.sourcename AS sourcename,
 flattened.depth as depth
FROM
 (SELECT flattened.* FROM (SELECT min(depth) AS depth, variable AS variable FROM flattened GROUP BY variable) AS foo JOIN flattened ON (foo.depth = flattened.depth AND foo.variable = flattened.variable)) AS flattened
 JOIN
 variable ON flattened.variable = variable.id
""", host_name, host_name)
    
    @staticmethod
    def do_get_vars(host_name):
